# Razorpay TEST mode credentials only. Never commit the real values.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me

# Choose a separate random value in Dashboard > Webhooks.
RAZORPAY_WEBHOOK_SECRET=replace_with_a_different_secret

# Hosted MCP endpoint. Docker is not required.
RAZORPAY_MCP_URL=https://mcp.razorpay.com/mcp

# Leave true until test credentials are available.
PAYMENTS_MOCK_MODE=true

# Telegram merchant alerts. Create a bot with the official @BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_NOTIFICATIONS=false
